# Copy this file to backend/.env and replace every placeholder.
# The API reads backend/.env only. Do not commit backend/.env.
# Never put the OpenRouter key in the frontend, a client request, or this example.

# SQLAlchemy URL. Keep the postgresql+psycopg driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/cx_assistant

# Browser origin allowed by CORS.
# The Vite dev server proxies /api, so the browser stays on the Vite origin.
# Set this to the real UI origin when the browser calls the API directly.
CORS_ORIGIN=http://localhost:5173

# Shown as the FastAPI title.
APP_NAME=Datastraw CX Assistant

# OpenRouter chat-completions key. Leave blank to run without a model.
# A blank key still retrieves knowledge and returns a human-review draft.
OPENROUTER_API_KEY=

# Model id sent to OpenRouter. Example: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenRouter API root. The server appends /chat/completions.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Seconds to wait for the model response.
OPENROUTER_TIMEOUT_SECONDS=20
